# 서버의 저장소 루트에 `.env` 라는 이름으로 두고 값을 채운다.
# (.gitignore 에 .env 가 있어 저장소에는 올라가지 않는다)
#
#   cp deploy/env.example .env   후 아래 두 값을 채울 것

# DB 를 SQLite 로 고정. user_data/freefontpick.db 를 쓴다.
# 이 값을 지우면 앱이 빈 MySQL 을 찾아가 데이터가 통째로 안 보인다.
FORCE_SQLITE=1

# 운영 주소(정본). 2026-09-16 부터 tdtd.io 다.
SITE_URL=https://freefontpick.tdtd.io

# 이 주소로 들어오면 SITE_URL 로 301 로 넘긴다(경로·쿼리 그대로).
LEGACY_HOSTS=freefontpick.co.kr,www.freefontpick.co.kr

# ── 아래 둘은 비밀값 ────────────────────────────────────────

# 카페24에서 쓰던 값을 그대로 옮긴다. 바꾸면 기존 웹폰트 CSS 주소가
# 전부 무효가 된다.
WEBFONT_CSS_KEY=여기에_카페24에서_쓰던_값

# 어드민 로그인 세션의 서명 키.
# 카페24에는 이 값이 없어서 앱이 재시작될 때마다 무작위로 새로 만들었고,
# 그때마다 어드민 로그인이 풀렸다. 여기서는 고정값을 넣는다.
#
#   만들기:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=여기에_새로_만든_값

# ── 추천 폰트 자판기 '사진으로 뽑기' (2026-11-03) ─────────────────
# Anthropic 콘솔(platform.claude.com)에서 만든 API 키. 비워 두면 사진 칸이 화면에 안 나온다.
# 콘솔에서 월 사용 한도(Limits)도 걸어 둘 것.
ANTHROPIC_API_KEY=
# 하루 횟수 울타리(서버 전체 · IP 하나). 모델을 바꾸려면 VENDING_PHOTO_MODEL (기본 claude-haiku-5-5)
VENDING_PHOTO_DAILY=1500
VENDING_PHOTO_PER_IP=15
